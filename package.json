{
  "name": "mheibos-gestor",
  "version": "0.2.0",
  "private": true,
  "description": "Launchers desktop do Mheibos Gestor e Mheibos Producao.",
  "main": "electron/main.js",
  "scripts": {
    "electron:gestor": "electron . --gestor",
    "electron:producao": "electron . --producao",
    "test:electron-secure": "node electron/secure_config.test.js && node electron/offline_runtime.test.js",
    "build:backend": "powershell -ExecutionPolicy Bypass -File tools/build_backend.ps1",
    "dist:suite": "electron-builder --config electron-builder.suite.yml",
    "dist:all": "powershell -ExecutionPolicy Bypass -File tools/build_suite.ps1",
    "dist:cliente": "electron-builder --config electron-builder.cliente.yml",
    "dist:gestor": "electron-builder --config electron-builder.gestor.yml",
    "dist:producao": "electron-builder --config electron-builder.producao.yml",
    "ui:capture": "node .agents/skills/mheibos-ui-engineering/scripts/capture_screenshots.js"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "playwright": "latest"
  }
}
